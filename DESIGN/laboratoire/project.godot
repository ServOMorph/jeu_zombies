; Engine configuration file.
; It is intentionally independent from the game project.

config_version=5

[application]

config/name="Nox Protocol — Laboratoire visuel"
config/description="Prévisualisation isolée des assets de conception."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]

environment/defaults/default_clear_color=Color(0.008, 0.012, 0.02, 1)
